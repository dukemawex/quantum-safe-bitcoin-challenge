+            {const uint32_t w=QSB_CONST_SCHEDULE[block][r+7];QSB_P2R(b0,c0,d0,e0,f0,g0,h0,a0,0,w);QSB_P2R(b1,c1,d1,e1,f1,g1,h1,a1,0,w);}
