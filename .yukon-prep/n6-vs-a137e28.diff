-                gt_point_to_limbs(grp, batch[j], x, y, alpha, beta, field_p, ctx, limbs);
-                size_t off = ((size_t)gt_offset(ch) + start + j) * 64;
-                memcpy(gTable + off, limbs, sizeof(limbs));
