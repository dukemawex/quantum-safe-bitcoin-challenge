-typedef struct {
-    uint64_t alpha[4];              /* u^2: affine x scale */
-    uint64_t beta[4];               /* u^3: affine y scale */
-    uint64_t invu[4];               /* restores original slopes */
-    uint64_t u2r_iso[8];            /* transformed recovery point */
-    uint32_t xneg;                  /* transformed xR is -1 iff set */
