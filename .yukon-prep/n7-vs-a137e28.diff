-                                  hH + ((size_t)ch * GT_HI + hi) * 8);
-        }
-#else
-        for (int hi = 1; hi < (int)(gt_entries(ch) >> 7); hi++) {   /* m=2d+1 < 2*entries */
-            gt_point_to_limbs(grp, acc, x, y, alpha,beta,field_p,ctx,
