-        int high=(int)(max_m>>12);
-        if(high>GT_HI-1) high=GT_HI-1;
-        gt_batch_ladder(grp,step,high,
-            hH+(size_t)ch*GT_HI*8,x,y,alpha,beta,field_p,ctx);
