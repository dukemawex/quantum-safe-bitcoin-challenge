-    uint32_t tx_suffix_len;
-    uint32_t prefix_remainder_len;   /* NEW: bytes of fixed_prefix not in midstate */
-    uint32_t midstate[8];
-    uint8_t *prefix_remainder;       /* NEW: the up-to-63 bytes before dummy sigs */
-    uint8_t *dummy_sigs;
